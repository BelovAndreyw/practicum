# ============================================================
# Командный зачёт — справочник переменных окружения
# ============================================================
# Для dev/test используйте корневой .env.example:
#   cp .env.example .env
# Для pilot:
#   cp .env.pilot.example .env.pilot
# Для фронтенда локально:
#   cp frontend/.env.example frontend/.env.development
# НИКОГДА не коммитьте .env в репозиторий!
# ============================================================

# === Database (PostgreSQL) ===
POSTGRES_USER=teamzachet
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=teamzachet
DATABASE_URL=postgresql+asyncpg://teamzachet:CHANGE_ME@postgres:5432/teamzachet

# === Backend / JWT ===
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
DEMO_MODE=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Примечание: если DEMO_MODE не задан в окружении, config.py использует True по умолчанию.
# Загрузка файлов: пути uploads/* на диске; volume uploads-pilot только в pilot compose.

# === CORS (планируется в backend) ===
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost

# === Auth / SSO УрФУ (планируется) ===
# SSO_ENABLED=false
# SSO_PROVIDER=oauth2
# SSO_OAUTH2_CLIENT_ID=
# SSO_OAUTH2_CLIENT_SECRET=
# SSO_OAUTH2_AUTHORIZE_URL=
# SSO_OAUTH2_TOKEN_URL=
# SSO_OAUTH2_USERINFO_URL=

# === Nginx ===
NGINX_SERVER_NAME=localhost

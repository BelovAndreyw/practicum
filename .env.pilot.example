# Пример окружения для PILOT-контура (без реальных секретов)
# На сервере .env.pilot создаётся CI из GitHub Secrets — в репо не коммитим.

# PostgreSQL (docker-compose)
POSTGRES_USER=teamzachet
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=teamzachet
DATABASE_URL=postgresql+asyncpg://teamzachet:CHANGE_ME@postgres:5432/teamzachet

# JWT (на pilot — обязательно длинный случайный ключ)
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEMO_MODE=false

# App
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
